# ─────────────────────────────────────────────────────────────
# Bewerbungsportal Jannikjbi's Treffpunkt – Umgebungsvariablen
# Kopieren nach .env (lokal) bzw. in Vercel → Settings → Environment Variables.
# NIEMALS echte Werte committen.
# ─────────────────────────────────────────────────────────────

# Öffentliche URL des Portals (ohne Slash am Ende)
NEXT_PUBLIC_APP_URL="https://portal.jannikjbi.de"
# Hauptseite (Footer, erlaubte Links in KI-Antworten)
NEXT_PUBLIC_MAIN_SITE_URL="https://www.jannikjbi.de"
# Dauerhafter Einladungslink zum Treffpunkt
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/f5ch3x3cMq"
# Link zu #regeln (optional, Standard: <Hauptseite>/discord)
# NEXT_PUBLIC_RULES_URL="https://discord.com/channels/<Server-ID>/<Kanal-ID>"

# ─── Datenbank: PostgreSQL (z. B. Neon) ───
# Vercel + Neon-Integration: setzt DATABASE_URL, DATABASE_URL_UNPOOLED und
# DATABASE_POSTGRES_PRISMA_URL – alles wird automatisch erkannt.
# Neon von Hand: DATABASE_URL = Verbindung „pooled“, DATABASE_URL_UNPOOLED = „direct“ (für Migrationen).
# Lokal:  npm run db:dev  →
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/treffpunkt"
# DATABASE_URL_UNPOOLED=""

# ─── Auth.js / Discord-OAuth ───
# Secret erzeugen: npx auth secret   (oder: openssl rand -base64 32)
AUTH_SECRET=""
# Discord Developer Portal → Applications → OAuth2
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Hinter Proxy/Vercel: Host-Header vertrauen
AUTH_TRUST_HOST="true"

# ─── Discord-Bot (Rollenprüfung, DMs, Log-Channel, Rollenvergabe) ───
DISCORD_BOT_TOKEN=""
# Server-ID (Rechtsklick auf den Server → ID kopieren; Entwicklermodus nötig)
DISCORD_GUILD_ID=""
# Nur wer eine dieser Rollen hat, kommt in den Team-Bereich (mehrere mit Komma)
TEAM_ROLE_ID=""
# Pflicht für Einstellungen, Formular-Builder, Sperrfristen, KI-Budget (mehrere mit Komma)
ADMIN_ROLE_ID=""
# Owner-Stufe über Admin (Owner, Co-Owner): Daten, Rollen, Sperren aufheben, Bot-Einrichtung, KI-Budget
OWNER_ROLE_ID=""
# Nur wer diese Rolle hat, kann absenden (👤 User = auf dem Discord verifiziert)
DISCORD_MEMBER_ROLE_ID=""
# Wer eine dieser Rollen hat, kann sich nicht bewerben (⛔ Blacklist, 🚷 Team-Sperre)
DISCORD_BLOCKED_ROLE_IDS=""
# 🚷 Team-Sperre: vergibt der Bot bei einer Sperre im Portal, entfernt sie nach Ablauf
DISCORD_TEAM_BAN_ROLE_ID=""
# ─── Discord-Kanäle (Kanal-ID, nur Ziffern; leer = diese Posts aus) ───
# Werden NUR hier bzw. in Vercel gesetzt – im Admin-Bereich steht nur, woher sie kommen.
# Nach Änderungen in Vercel: Deployments → „Redeploy“, erst dann gelten sie.
DISCORD_LOG_CHANNEL_ID=""              # Bot-Logs
DISCORD_APPLICATIONS_CHANNEL_ID=""     # neue Bewerbungen
DISCORD_JOBS_CHANNEL_ID=""             # Stellenaufruf
DISCORD_SPOTLIGHT_CHANNEL_ID=""        # Einzelaufrufe
DISCORD_CHANGELOG_CHANNEL_ID=""        # Changelog
DISCORD_TEAM_CHANNEL_ID=""             # Teamchat (Team-Übersicht)
DISCORD_LEAD_CHANNEL_ID=""             # Leitungs-Chat (Alarme)
DISCORD_WELCOME_CHANNEL_ID=""          # Willkommensgruß & Jubiläen
DISCORD_INTERVIEW_VOICE_CHANNEL_ID=""  # Sprachkanal fürs Gespräch
DISCORD_WAITING_ROOM_CHANNEL_ID=""     # Warteraum-Sprachkanal
# Wie lange eine Rollenprüfung gecacht wird (Sekunden)
ROLE_CACHE_TTL_SECONDS="60"

# ─── „Jannik ist live“ auf der Startseite (optional) ───
# dev.twitch.tv → Your Console → Applications → Register (OAuth Redirect: http://localhost, Kategorie: Website Integration)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# ─── KI (optional) – Anthropic Claude ───
ANTHROPIC_API_KEY=""
AI_MODEL_DEFAULT="claude-sonnet-5-5"
AI_MODEL_FAST="claude-haiku-5-5"

# Präfix der Bewerbungs-IDs (JT-2026-0001)
PUBLIC_ID_PREFIX="JT"

# ─── NUR lokal: Login als Seed-Nutzer ohne Discord (in Produktion wirkungslos) ───
# DEV_LOGIN="true"
